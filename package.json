{
  "name": "cura",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres postgres-test redis redis-test",
    "db:migrate": "pnpm --filter @cura/api migrate up",
    "db:migrate:test": "pnpm --filter @cura/api migrate:test up"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  }
}
