# =============================================================================
# Cura — configuration de DÉVELOPPEMENT
# Copier vers `.env` puis remplacer les valeurs `change-me`.
# `.env` n'est JAMAIS versionné (voir .gitignore).
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true

# --- PostgreSQL (base de DEV : cura_dev) --------------------------------------
POSTGRES_USER=cura
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cura_dev
DATABASE_URL=postgres://cura:change-me@localhost:5432/cura_dev
DATABASE_POOL_MAX=20
DATABASE_SSL=false
MIGRATIONS_DIR=../../packages/db/migrations

# --- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0
REDIS_KEY_PREFIX=cura:

# --- Authentification ----------------------------------------------------------
JWT_ACCESS_SECRET=change-me-with-at-least-32-random-characters
JWT_ISSUER=cura-api
JWT_AUDIENCE=cura-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# false uniquement en local (HTTP). Obligatoirement true en production.
COOKIE_SECURE=false

# --- HTTP ----------------------------------------------------------------------
# Origines autorisées (app cabinet Vite, Expo web, Nginx local).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8080
# 0 en exécution locale directe, 1 derrière Nginx (docker compose le force à 1).
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
SWAGGER_ENABLED=true

# --- Réservation ---------------------------------------------------------------
BOOKING_HOLD_TTL_SECONDS=300
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_LOCK_TIMEOUT_MS=3000
BOOKING_MAX_ACTIVE_PER_PATIENT=3

# --- Temps réel (relais outbox → Socket.io) ---
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7

# --- Amorçage (pnpm --filter @cura/api create-admin) ---------------------------
ADMIN_EMAIL=admin@cura.local
ADMIN_PASSWORD=change-me-strong-password
