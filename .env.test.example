# =============================================================================
# Cura — configuration des TESTS
# Pointe vers des conteneurs DÉDIÉS (postgres-test :5433, redis-test :6380),
# en mémoire (tmpfs) : les tests ne peuvent pas toucher la base de dev.
# Valeurs factices, sans secret réel : utilisable tel quel (copie optionnelle vers .env.test).
# =============================================================================
NODE_ENV=test
LOG_LEVEL=silent
LOG_PRETTY=false

DATABASE_URL=postgres://cura_test:cura_test_password@localhost:5433/cura_test
DATABASE_POOL_MAX=25
MIGRATIONS_DIR=../../packages/db/migrations

REDIS_URL=redis://:cura_test_redis@localhost:6380/0
REDIS_KEY_PREFIX=cura-test:

JWT_ACCESS_SECRET=test-secret-not-for-production-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=10000
RATE_LIMIT_AUTH_MAX=1000
SWAGGER_ENABLED=true

BOOKING_HOLD_TTL_SECONDS=300
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_LOCK_TIMEOUT_MS=5000
