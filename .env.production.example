# =============================================================================
# Cura — configuration de PRODUCTION (modèle)
# Copier vers `.env.production` sur le serveur, jamais dans Git.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# Tous les secrets doivent être générés aléatoirement (48+ caractères).
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info
LOG_PRETTY=false

POSTGRES_USER=cura
POSTGRES_PASSWORD=
POSTGRES_DB=cura_prod
# Base managée externe : renseigner DATABASE_URL et DATABASE_SSL=true
DATABASE_SSL=false

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
# COOKIE_DOMAIN=cabinet.example.com

CORS_ORIGINS=https://cabinet.example.com
TRUST_PROXY_HOPS=1
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
SWAGGER_ENABLED=false

BOOKING_HOLD_TTL_SECONDS=300
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_LOCK_TIMEOUT_MS=3000
BOOKING_MAX_ACTIVE_PER_PATIENT=3

# --- Temps réel (relais outbox → Socket.io) ---
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7

SERVER_NAME=cabinet.example.com
