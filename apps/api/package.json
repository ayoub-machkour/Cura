{
  "name": "@cura/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "migrate:test": "tsx --env-file=../../.env.test src/migrate.ts",
    "migrate:create": "tsx src/migrate.ts create",
    "create-admin": "tsx --env-file=../../.env src/create-admin.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cura/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@socket.io/redis-adapter": "~8.3.0",
    "fast-jwt": "^5.0.6",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "6.1.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "socket.io": "~4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv": "^16.4.7",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "~4.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
